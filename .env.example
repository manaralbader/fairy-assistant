# Copy this file to `.env` (already gitignored — it will never be committed)
# and fill in your own keys. Neither service requires a credit card for its
# free tier, and neither can charge you unless you separately add billing.

# Commercial backend — Google AI Studio (aistudio.google.com), free tier,
# no card required: https://ai.google.dev/gemini-api/docs/openai
FAIRY_COMMERCIAL_API_KEY=
FAIRY_COMMERCIAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAIRY_COMMERCIAL_MODEL=gemini-2.5-flash

# Open-weight backend — Groq (console.groq.com), free tier, no card required
FAIRY_OPEN_WEIGHT_API_KEY=
FAIRY_OPEN_WEIGHT_BASE_URL=https://api.groq.com/openai/v1
FAIRY_OPEN_WEIGHT_MODEL=llama-3.3-70b-versatile
